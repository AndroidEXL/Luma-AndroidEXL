<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#F0F1FF"
                android:endColor="#EAF8FF"
                android:startColor="#FBFBFF" />
        </shape>
    </item>
    <item android:top="-180dp" android:right="-120dp">
        <shape android:shape="oval">
            <solid android:color="#3A7C5CFC" />
        </shape>
    </item>
    <item android:bottom="-220dp" android:left="-160dp">
        <shape android:shape="oval">
            <solid android:color="#2340D9FF" />
        </shape>
    </item>
</layer-list>
