<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/project_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/project_template_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/templateSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_surface"
        android:entries="@array/project_templates"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/project_template_description"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/choose_icon"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/iconToggleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedButton="@id/iconSparkButton"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/iconSparkButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="72dp"
                android:layout_height="66dp"
                android:contentDescription="@string/icon_spark"
                app:icon="@drawable/ic_spark"
                app:iconGravity="textTop"
                app:iconSize="24dp"
                android:text="@string/icon_spark"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/iconChipButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="72dp"
                android:layout_height="66dp"
                android:contentDescription="@string/icon_chip"
                app:icon="@drawable/ic_arduino_chip"
                app:iconGravity="textTop"
                app:iconSize="24dp"
                android:text="@string/icon_chip"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/iconRobotButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="72dp"
                android:layout_height="66dp"
                android:contentDescription="@string/icon_robot"
                app:icon="@drawable/ic_robot"
                app:iconGravity="textTop"
                app:iconSize="24dp"
                android:text="@string/icon_robot"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/iconSensorButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="72dp"
                android:layout_height="66dp"
                android:contentDescription="@string/icon_sensor"
                app:icon="@drawable/ic_sensor"
                app:iconGravity="textTop"
                app:iconSize="24dp"
                android:text="@string/icon_sensor"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/iconLightButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="72dp"
                android:layout_height="66dp"
                android:contentDescription="@string/icon_light"
                app:icon="@drawable/ic_light"
                app:iconGravity="textTop"
                app:iconSize="24dp"
                android:text="@string/icon_light"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/iconRocketButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_rocket" app:icon="@drawable/ic_project_rocket" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_rocket" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconTerminalButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_terminal" app:icon="@drawable/ic_project_terminal" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_terminal" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconBoltButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_bolt" app:icon="@drawable/ic_project_bolt" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_bolt" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconWifiButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_wifi" app:icon="@drawable/ic_project_wifi" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_wifi" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconMotorButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_motor" app:icon="@drawable/ic_project_motor" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_motor" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconThermoButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_thermo" app:icon="@drawable/ic_project_thermo" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_thermo" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconDisplayButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_display" app:icon="@drawable/ic_project_display" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_display" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconMusicButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_music" app:icon="@drawable/ic_project_music" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_music" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconCameraButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_camera" app:icon="@drawable/ic_project_camera" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_camera" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconBluetoothButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_bluetooth" app:icon="@drawable/ic_project_bluetooth" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_bluetooth" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconCloudButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_cloud" app:icon="@drawable/ic_project_cloud" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_cloud" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconLockButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_lock" app:icon="@drawable/ic_project_lock" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_lock" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconClockButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_clock" app:icon="@drawable/ic_project_clock" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_clock" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconLeafButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_leaf" app:icon="@drawable/ic_project_leaf" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_leaf" android:textAllCaps="false" android:textSize="10sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/iconSatelliteButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="72dp" android:layout_height="66dp" android:contentDescription="@string/icon_satellite" app:icon="@drawable/ic_project_satellite" app:iconGravity="textTop" app:iconSize="24dp" android:text="@string/icon_satellite" android:textAllCaps="false" android:textSize="10sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/choose_icon_description"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />
</LinearLayout>
