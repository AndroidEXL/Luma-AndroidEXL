<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/orb_violet" />

    <TextView
        android:id="@+id/actionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/project_actions_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/actionsProjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="none"
        android:maxLines="3"
        android:textColor="@color/text_secondary"
        android:textDirection="locale"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backupAction"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="18dp"
        android:gravity="start|center_vertical"
        android:text="@string/backup_project"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:icon="@drawable/ic_restore"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/duplicateAction"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="start|center_vertical"
        android:text="@string/duplicate_project"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/detailsAction"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="start|center_vertical"
        android:text="@string/project_details"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exportAction"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="start|center_vertical"
        android:text="@string/export_project"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:icon="@drawable/ic_export"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteAction"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="start|center_vertical"
        android:text="@string/delete_project"
        android:textAllCaps="false"
        android:textColor="#D84D68"
        android:textSize="16sp"
        app:icon="@drawable/ic_delete"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp"
        app:iconTint="#D84D68" />
</LinearLayout>
