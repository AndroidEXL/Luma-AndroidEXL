<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:layoutDirection="rtl">

    <View
        android:id="@+id/orbTop"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="54dp"
        android:background="@drawable/orb_cyan" />

    <View
        android:id="@+id/orbBottom"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="180dp"
        android:layout_marginStart="58dp"
        android:background="@drawable/orb_violet" />

    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/logo_background"
            android:elevation="14dp">

            <ImageView
                android:id="@+id/logoMark"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_spark" />
        </FrameLayout>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="sans"
            android:letterSpacing="0.12"
            android:text="@string/splash_title"
            android:textColor="@color/splash_text_primary"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans"
            android:text="@string/splash_tagline"
            android:textColor="@color/splash_text_secondary"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/loadingBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="108dp"
            android:layout_height="3dp"
            android:layout_marginTop="40dp"
            android:indeterminate="true"
            android:progressTint="@color/cyan_400"
            android:visibility="visible" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="sans"
            android:text="@string/splash_loading"
            android:textColor="@color/splash_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="38dp"
        android:fontFamily="sans"
        android:text="2026  •  LUMA STUDIO"
        android:textColor="@color/splash_footer"
        android:textSize="10sp"
        android:letterSpacing="0.18" />
</FrameLayout>
