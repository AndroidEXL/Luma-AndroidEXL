<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnimatedSplashKotlin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/toolbar_surface</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/violet_500</item>
    </style>

    <style name="Theme.AnimatedSplashKotlin.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/splash_status_bar</item>
        <item name="android:navigationBarColor">@color/splash_navigation_bar</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
